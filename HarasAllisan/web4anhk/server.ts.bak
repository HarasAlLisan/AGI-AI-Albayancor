import express from "express";
import cors from "cors";
import path from "path";
import fs from "fs";
const app = express();
app.use(cors());
app.use(express.json({limit:"5mb"}));

const distPath = path.join(process.cwd(),"dist");
if(fs.existsSync(distPath)){
  app.use(express.static(distPath));
}

async function runAgi(prompt:string){
  const { jasadWahid } = await import("./src/ai/body/jasadWahid.ts");
  return await jasadWahid(prompt);
}
app.post("/api/agi/run", async (req,res)=>{
  const p = req.body.prompt || req.body.message || "";
  const r = await runAgi(p);
  res.json({ final: r.final, text: r.final, token: r.token, source: r.source });
});
app.post("/api/gemini/assistant-chat", async (req,res)=>{
  const r = await runAgi(req.body.prompt || req.body.message || "");
  res.json({ final: r.final, text: r.final });
});
app.post("/api/bayan/analyze", async (req,res)=>{
  const r = await runAgi(req.body.prompt || "");
  res.json({ final: r.final, text: r.final, result: r.final, analysis: r.final });
});
app.post("/api/haris/chat", async (req,res)=>{
  const r = await runAgi(req.body.prompt || "");
  res.json({ final: r.final, text: r.final });
});

app.get("*", (req,res)=>{
  const indexFile = path.join(distPath,"index.html");
  if(fs.existsSync(indexFile)) return res.sendFile(indexFile);
  // لو dist مش موجود - رجع صفحة مؤقتة عشان متقعش
  res.send(`<html><body><h2>M5 28612030103352 running</h2><p>dist محذوف - اعمل npm run build</p><script>fetch('/api/agi/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({prompt:'عرف نفسك'})}).then(r=>r.json()).then(d=>document.body.innerHTML+= '<pre>'+d.final+'</pre>')</script></body></html>`);
});

app.listen(4000,"0.0.0.0",()=> console.log("M5 28612030103352 on 4000 -> qwen-anhk:latest"));
